{
  "debug": false,
  "grafana": {
    "token_env": "GRAFANA_S2S_TOKEN",
    "timeout_seconds": 30
  },
  "teams": {
    "webhook_url_env": "TEAMS_WEBHOOK_URL",
    "timeout_seconds": 30,
    "retries": 4
  },
  "aws": {
    "access_key_env": "AWS_ACCESS_KEY_ID",
    "secret_key_env": "AWS_SECRET_ACCESS_KEY",
    "region_env": "AWS_REGION"
  },
  "template": "templates/aws_cost_report.md.j2",
  "datasources": [
    {
      "name": "athena",
      "model": {
        "format": "table",
        "rawQuery": true
      }
    },
    {
      "name": "openobserve",
      "model": {
        "format": "table"
      }
    }
  ],
  "sections": [
    {
      "title": "AWS Cost",
      "enabled": true,
      "queries": [
        {
          "name": "daily_cost",
          "datasource": "athena",
          "sql_file": "queries/daily_cost.sql",
          "display": "calendar"
        },
        {
          "name": "monthly_cost",
          "datasource": "athena",
          "sql_file": "queries/monthly_cost.sql"
        },
        {
          "name": "cost_by_service",
          "datasource": "athena",
          "sql_file": "queries/cost_by_service.sql"
        }
      ]
    },
    {
      "title": "EC2 Inventory",
      "enabled": true,
      "queries": [
        {
          "name": "ec2_by_budgetcode",
          "type": "ec2",
          "enabled": true,
          "untagged_label": "none"
        }
      ]
    },
    {
      "title": "Service Status",
      "enabled": true,
      "queries": [
        {
          "name": "http_5xx_ratio",
          "datasource": "openobserve",
          "model": {
            "query": "SELECT service, COUNT(*) AS total, SUM(status_code >= 500) AS fivexx FROM logs WHERE timestamp >= now() - INTERVAL '24' HOUR GROUP BY service",
            "format": "table"
          }
        }
      ]
    }
  ]
}
